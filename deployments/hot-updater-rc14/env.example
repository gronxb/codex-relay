# Read ENVIRONMENT.md for purpose, required/optional conditions, and secure sources.
# Set only applicable values in your ignored local environment file.
# Do not paste credentials into chat or copy unused empty credential fields.

# Cloudflare account ID
HOT_UPDATER_CLOUDFLARE_ACCOUNT_ID=

# API token with D1 edit permission
HOT_UPDATER_CLOUDFLARE_API_TOKEN=

# R2 bucket name
HOT_UPDATER_CLOUDFLARE_R2_BUCKET_NAME=

# R2 access key ID
HOT_UPDATER_CLOUDFLARE_R2_ACCESS_KEY_ID=

# R2 secret access key
HOT_UPDATER_CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Worker name
HOT_UPDATER_CLOUDFLARE_WORKER_NAME=

# D1 database ID
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_ID=

# D1 database name
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_NAME=

# Whether the R2 bucket is private (true or false)
HOT_UPDATER_CLOUDFLARE_R2_PRIVATE=

# Client x-api-key; reuse the existing key or provision it after schema setup
HOT_UPDATER_API_KEY=
